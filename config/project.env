# Project settings shared by everyone who deploys this repository.
# Values specific to you go in .env, which is read after this file and
# overrides anything set here.

# Unity Catalog
CATALOG=capital_bikeshare
LANDING_VOLUME=landing
ENGINEERS_GROUP=bikeshare_engineers
ANALYSTS_GROUP=bikeshare_analysts
DASHBOARD_VIEWERS_GROUP=bikeshare_dashboard_viewers

# Historical trips: three consecutive months, as YYYY-MM.
TRIP_MONTHS=2025-04,2025-05,2025-06
TRIP_BASE_URL=https://s3.amazonaws.com/capitalbikeshare-data

# Live station feeds. Feed URLs are resolved from the discovery file at run time.
GBFS_DISCOVERY_URL=https://gbfs.capitalbikeshare.com/gbfs/gbfs.json
GBFS_FEEDS=station_status,station_information
GBFS_POLL_MINUTES=15

# Schedules: UNPAUSED or PAUSED
GBFS_SCHEDULE_STATUS=UNPAUSED
PIPELINE_SCHEDULE_STATUS=UNPAUSED
TIMEZONE=America/New_York
