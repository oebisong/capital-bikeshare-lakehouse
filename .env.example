# Copy this file to .env and fill in your own values.
# .env is git-ignored. Never commit it.
#
# This project needs no passwords, tokens or keys. You sign in to each CLI
# yourself, and Databricks reaches storage through a managed identity.
# If you add a secret later, such as a webhook URL, put it here.

# Azure subscription to deploy into: az account show --query id -o tsv
AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000

# Azure region for every resource
AZURE_LOCATION=eastus

# Short lowercase prefix for resource names, 3 to 10 letters or digits
NAME_PREFIX=cabi

# Name of the Databricks CLI profile that make databricks-login creates
DATABRICKS_PROFILE=cabi

# Address that receives job failure emails
ALERT_EMAIL=you@example.com
