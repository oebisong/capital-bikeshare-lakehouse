{
  "datasets": [
    {
      "name": "trip_period",
      "displayName": "Trip period",
      "queryLines": [
        "SELECT min(trip_date) AS first_day, max(trip_date) AS last_day, sum(trips) AS trips,\n",
        "       round(sum(trips) / count(DISTINCT trip_date), 0) AS trips_per_day\n",
        "FROM agg_daily_ridership\n"
      ]
    },
    {
      "name": "daily_trips",
      "displayName": "Daily trips",
      "queryLines": [
        "SELECT trip_date, member_type, sum(trips) AS trips\n",
        "FROM agg_daily_ridership GROUP BY ALL\n"
      ]
    },
    {
      "name": "weekday_trips",
      "displayName": "Trips by day of week",
      "queryLines": [
        "SELECT concat(day_of_week, ' ', left(day_name, 3)) AS day, member_type,\n",
        "       sum(trips) AS trips\n",
        "FROM agg_daily_ridership GROUP BY ALL\n"
      ]
    },
    {
      "name": "rider_mix",
      "displayName": "Trips by rider and bike type",
      "queryLines": [
        "SELECT member_type, rideable_type, sum(trips) AS trips\n",
        "FROM agg_daily_ridership GROUP BY ALL\n"
      ]
    },
    {
      "name": "hourly_demand",
      "displayName": "Hourly demand",
      "queryLines": [
        "SELECT hour_of_day, day_type, sum(avg_departures_per_day) AS avg_departures_per_day\n",
        "FROM agg_hourly_station_demand GROUP BY ALL\n"
      ]
    },
    {
      "name": "top_departures",
      "displayName": "Busiest departure stations",
      "queryLines": [
        "SELECT station_name, sum(departures) AS departures\n",
        "FROM agg_hourly_station_demand GROUP BY ALL ORDER BY departures DESC LIMIT 15\n"
      ]
    },
    {
      "name": "top_arrivals",
      "displayName": "Busiest arrival stations",
      "queryLines": [
        "SELECT station_name, sum(arrivals) AS arrivals\n",
        "FROM agg_hourly_station_demand GROUP BY ALL ORDER BY arrivals DESC LIMIT 15\n"
      ]
    },
    {
      "name": "monitoring_period",
      "displayName": "GBFS monitoring period",
      "queryLines": [
        "SELECT min(first_observed_at) AS first_observation, max(last_observed_at) AS latest_observation,\n",
        "       sum(observations) AS observations, count(*) AS stations\n",
        "FROM agg_station_availability\n"
      ]
    },
    {
      "name": "empty_stations",
      "displayName": "Stations most often observed empty",
      "queryLines": [
        "SELECT station_name, round(100 * empty_rate, 1) AS empty_pct, observations\n",
        "FROM agg_station_availability WHERE observations >= 20\n",
        "ORDER BY empty_rate DESC LIMIT 15\n"
      ]
    },
    {
      "name": "full_stations",
      "displayName": "Stations most often observed full",
      "queryLines": [
        "SELECT station_name, round(100 * full_rate, 1) AS full_pct, observations\n",
        "FROM agg_station_availability WHERE observations >= 20\n",
        "ORDER BY full_rate DESC LIMIT 15\n"
      ]
    },
    {
      "name": "availability_by_hour",
      "displayName": "Availability by hour",
      "queryLines": [
        "SELECT hour_of_day, day_type, round(100 * empty_rate, 1) AS empty_pct,\n",
        "       round(100 * full_rate, 1) AS full_pct\n",
        "FROM agg_availability_by_hour\n"
      ]
    }
  ],
